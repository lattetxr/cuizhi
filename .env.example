# LLM（OpenAI 兼容接口；不配置时自动进入 Mock 模式）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# CUZHI_LLM_MODE=mock

# 知乎 OAuth App Key（生产/部署时通过平台 Secret 注入，不写入源码）
ZHIHU_OAUTH_APP_KEY=

# 知乎开放平台 Access Secret（生产/部署时通过平台 Secret 注入）
ZHIHU_ACCESS_SECRET=

# 本地数据目录（可选）
# CUZHI_DATA_DIR=./.data
